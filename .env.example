NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://goomevents.ca
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Ticket payment mode. Use mock only with npm run dev; production always uses Square.
PAYMENT_PROVIDER=mock
PAYMENT_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=sandbox-square-application-id
SQUARE_APPLICATION_SECRET=server-only-square-application-secret
SQUARE_OAUTH_REDIRECT_URL=http://localhost:3000/api/payments/square/callback
SQUARE_WEBHOOK_URL=https://your-public-tunnel.example/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=server-only-webhook-signature-key

# Optional ticket email delivery through Resend.
RESEND_API_KEY=server-only-resend-api-key
TICKETS_FROM_EMAIL=GOOM Tickets <tickets@your-verified-domain.com>

# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
